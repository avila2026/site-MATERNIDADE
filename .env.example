# ============================================================
# Achadinhos Maternidade - Environment Variables
# ============================================================
# Copie este arquivo para .env.local e preencha suas chaves.
# NUNCA commite o arquivo .env.local no git.
# ============================================================

# --- Google Gemini (AI Studio) ---
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Anthropic Claude ---
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Configuração do Provedor Padrão ---
# Valores: "gemini" | "anthropic"
VITE_DEFAULT_AI_PROVIDER=gemini
